# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grumeup?schema=public

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Application ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Authentication ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=admin@grumeup.com
INITIAL_ADMIN_PASSWORD=admin_secure_password_123

# ─── SMTP Email (Gmail) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@grumeup.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="GrumeUp Queue <admin@grumeup.com>"

# ─── Security ──────────────────────────────────────────────
# Rate limiting (requests per minute)
RATE_LIMIT_MAX=100
